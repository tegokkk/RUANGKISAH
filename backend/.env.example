HOST=127.0.0.1
PORT=4000
PUBLIC_URL=http://localhost:5173
DATA_DIR=.data
# Local default is sqlite. Production/Vercel requires postgres and a real DATABASE_URL.
DATABASE_PROVIDER=sqlite
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=1
DATABASE_CA_CERT=
# Local administrative scripts only; never expose this in frontend/Vercel runtime.
MIGRATION_DATABASE_URL=
# Set a unique secret of at least 32 characters in production.
AUTH_SECRET=
# file stores messages privately on this server for local development only.
MAIL_MODE=file
# Production: MAIL_MODE=smtp, a configured SMTP_URL and an approved MAIL_FROM.
SMTP_URL=
MAIL_FROM=
# Set true after building frontend to serve UI and API on the same origin.
SERVE_FRONTEND=false
# Used only by npm run bootstrap. Never commit real values.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=
RUNTIME_DB_PASSWORD=
