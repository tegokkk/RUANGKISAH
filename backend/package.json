{
  "name": "ruangkisah-backend",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "bootstrap": "node --env-file-if-exists=.env scripts/bootstrap-admin.js",
    "start:local": "node --env-file-if-exists=.env scripts/serve-local.js",
    "lint": "eslint .",
    "format:check": "prettier . --check",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "test:postgres": "node scripts/test-postgres.js",
    "db:import-sqlite": "node --env-file-if-exists=.env scripts/import-sqlite.js",
    "db:create-runtime": "node --env-file-if-exists=.env scripts/create-runtime-role.js"
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "1.7.25",
    "@vercel/functions": "3.11.3",
    "better-auth": "^1.7.25",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "kysely": "0.29.9",
    "nodemailer": "^10.6.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
