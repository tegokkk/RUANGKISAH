# Copy to backend/.env for private setup scripts; enter server values in Vercel Dashboard.
# Never commit backend/.env or send these values in chat.
NODE_ENV=production
DATABASE_PROVIDER=postgres
# Vercel: transaction pooler URI from Supabase Connect, using ruangkisah_runtime.
# This is NOT the https://<project>.supabase.co project API URL.
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=1
# Supabase root CA PEM if required by your project's certificate chain.
DATABASE_CA_CERT=
# Local setup only: admin URI using Direct or Session Pooler, never put in Vercel.
MIGRATION_DATABASE_URL=
AUTH_SECRET=
PUBLIC_URL=
SERVE_FRONTEND=false
TRUST_PROXY_HOPS=1
# Local one-time setup only; never configure these on Vercel.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=
RUNTIME_DB_PASSWORD=
